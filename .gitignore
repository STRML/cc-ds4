__pycache__/
*.py[cod]
.pytest_cache/

# Never commit anything that has touched a profile: these hold session cost state,
# account balances, and a verbatim dump of a Claude Code payload.
cost-state/
spend-ledger.jsonl
balance-cache.json
last-statusline-input.json
*.bak-*

# Agent tool state, not project source. .claude/ holds git worktrees, so
# committing it would nest a second checkout of this repo inside itself.
.claude/
.serena/

# Scratch and accidental dirs: CCR worktree clones + tarball, and a stray
# profile-config dir created by an unexpanded tilde.
.tmp/
~/
